{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Android emulator",
      "type": "shell",
      "command": "./scripts/run_emulator.sh start",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false
      }
    },
    {
      "label": "Rebuild & install on emulator",
      "type": "shell",
      "command": "./scripts/run_emulator.sh install",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false,
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run on emulator (attached)",
      "type": "shell",
      "command": "./scripts/run_emulator.sh phone",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    },
    {
      "label": "List emulators & devices",
      "type": "shell",
      "command": "./scripts/run_emulator.sh --list",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false
      }
    }
  ]
}
